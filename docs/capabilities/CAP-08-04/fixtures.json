  "semanticCases": [
    {
      "id": "SEM-01",
      "name": "LinuxCNC候选M6冷却不自动关闭",
      "profile": {
        "m6Coolant": "PRESERVE",
        "m19Supported": true
      },
      "commands": [
        "COOLANT_ON",
        "T_SELECT",
        "M6_ACK"
      ],
      "expected": "PASS",
      "expectedCoolant": "ON",
      "expectedOffset": "NOT_APPLIED"
    },
    {
      "id": "SEM-02",
      "name": "Haas摘要提示M06冷却自动关闭仅作差异测试",
      "profile": {
        "m6Coolant": "STOP",
        "m19Supported": true
      },
      "commands": [
        "COOLANT_ON",
        "T_SELECT",
        "M6_ACK"
      ],
      "expected": "PASS",
      "expectedCoolant": "OFF",
      "expectedOffset": "NOT_APPLIED"
    },
    {
      "id": "SEM-03",
      "name": "M6未获确认不得宣称换刀成功",
      "profile": {
        "m6Coolant": "PRESERVE",
        "m19Supported": true
      },
      "commands": [
        "T_SELECT",
        "M6_REQUEST"
      ],
      "expected": "UNKNOWN"
    },
    {
      "id": "SEM-04",
      "name": "M19未收到定向设备回执不得完成",
