      "commands": [
        "M19_REQUEST"
      ],
      "expected": "UNKNOWN"
    },
    {
      "id": "SEM-05",
      "name": "M19经合成ACK可生成已观测事件但非真实机床证明",
      "profile": {
        "m6Coolant": "PRESERVE",
        "m19Supported": true
      },
      "commands": [
        "M19_REQUEST",
        "M19_ACK"
      ],
      "expected": "PASS"
    },
    {
      "id": "SEM-06",
      "name": "M30后的命令不得继续执行",
      "profile": {
        "m6Coolant": "PRESERVE",
        "m19Supported": true
      },
      "commands": [
        "M30",
        "SPINDLE_START"
      ],
      "expected": "REJECT"
    },
    {
      "id": "SEM-07",
      "name": "未知厂商M代码Fail-Closed",
